        #endregion

        #region Internals

        // Sum of entity counts of all included archetypes (predicates not evaluated).
        private int IncludedCount
        {
            get
            {
                var sum = 0;
                foreach (var table in Archetypes)
                {
                    if (Includes(table)) sum += table.Count;
                }
                return sum;
            }
        }

        private bool HasWildcards => Stream.StreamTypes.Any(type => type.isWildcard);

        private void AssertNoWildcards()
        {
            if (HasWildcards)
                throw new InvalidOperationException(
                    $"Cannot run this operation on wildcard Stream Types (write destination Aliasing). {Stream.StreamTypes}");
        }

        /// <inheritdoc />
        public override string ToString() =>
            $"FilteredStream<{string.Join(", ", Stream.StreamTypes)}>(Has: {_has.Count}, Not: {_not.Count}, Where: {<#= string.Join(" + ", Enumerable.Range(0, n).Select(i => $"(_filter{i} is null ? 0 : 1)")) #>})";
        #endregion
    }
<#
    } // end for n
#>
}
