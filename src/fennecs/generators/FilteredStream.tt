            {
                if (Pass(<#= inSpanArgs #>)) included(new EntityRef(table, i), <#= refSpanArgs #>);
                else excluded(new EntityRef(table, i), <#= refSpanArgs #>);
            }
        }

        private void LoopDualUniform<U>(<#= spanParams #>, UniformComponentAction<U, <#= types #>> included, UniformComponentAction<U, <#= types #>> excluded, U uniform)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (Pass(<#= inSpanArgs #>)) included(uniform, <#= refSpanArgs #>);
                else excluded(uniform, <#= refSpanArgs #>);
            }
        }

        private void LoopDualUniformEntity<U>(Archetype table, <#= spanParams #>, UniformEntityComponentAction<U, <#= types #>> included, UniformEntityComponentAction<U, <#= types #>> excluded, U uniform)
        {
            var length = span0.Length;
