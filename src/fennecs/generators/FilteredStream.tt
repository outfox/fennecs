            {
                if (Pass(<#= inSpanArgs #>)) included(uniform, new EntityRef(table, i), <#= refSpanArgs #>);
                else excluded(uniform, new EntityRef(table, i), <#= refSpanArgs #>);
            }
        }

        private static void LoopAll(<#= spanParams #>, ComponentAction<<#= types #>> action)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                action(<#= refSpanArgs #>);
            }
        }

        private static void LoopAllEntity(Archetype table, <#= spanParams #>, EntityComponentAction<<#= types #>> action)
        {
