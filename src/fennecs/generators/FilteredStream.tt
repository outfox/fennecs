                if (!Includes(table)) continue;
                using var join = table.CrossJoin<<#= types #>>(Stream.StreamTypes.AsSpan());
                if (join.Empty) continue;
                var snapshot = table.Version;
                do
                {
                    var <#= selectVars #> = join.Select;
                    for (var i = 0; i < table.Count; i++)
                    {
                        if (!Pass(<#= string.Join(", ", Enumerable.Range(0, n).Select(i => $"s{i}[i]")) #>)) continue;
                        yield return (table[i], <#= string.Join(", ", Enumerable.Range(0, n).Select(i => $"s{i}[i]")) #>);
                        if (table.Version != snapshot) throw new InvalidOperationException("Collection was modified during iteration.");
                    }
                } while (join.Iterate());
            }
        }
        IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
        #endregion

        #region Despawn
        /// <summary>
        /// Despawn all Entities matched by this FilteredStream, honoring all filters.
        /// </summary>
        /// <remarks>
        /// With per-entity predicates set, this is not supported on wildcard Stream Types.
        /// </remarks>
        public void Despawn()
        {
            if (!HasPredicates)
            {
                // Loop because Truncate side effects (e.g. relation cleanup) can migrate
                // entities into matched archetypes.
                while (IncludedCount > 0)
                {
                    using var worldLock = World.Lock();
                    foreach (var table in Archetypes)
                    {
                        if (Includes(table)) table.Truncate(0);
                    }
                }
                return;
            }

            AssertNoWildcards();
            using var doomed = PooledList<Entity>.Rent();
            using (var worldLock = World.Lock())
            {
                foreach (var table in Archetypes)
                {
                    if (!Includes(table)) continue;
                    using var join = table.CrossJoin<<#= types #>>(Stream.StreamTypes.AsSpan());
                    if (join.Empty) continue;
                    do
                    {
                        var <#= selectVars #> = join.Select;
                        Collect(table, <#= selectSpans #>, doomed);
                    } while (join.Iterate());
                }
            }
            foreach (var entity in doomed)
            {
                if (entity.Alive) World.Despawn(entity);
            }
        }

        private void Collect(Archetype table, <#= spanParams #>, PooledList<Entity> doomed)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (Pass(<#= inSpanArgs #>)) doomed.Add(table[i]);
            }
        }
        #endregion

        #region Action Loops
        private void Loop(<#= spanParams #>, ComponentAction<<#= types #>> action)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (!Pass(<#= inSpanArgs #>)) continue;
                action(<#= refSpanArgs #>);
            }
        }

        private void LoopEntity(Archetype table, <#= spanParams #>, EntityComponentAction<<#= types #>> action)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (!Pass(<#= inSpanArgs #>)) continue;
                action(new EntityRef(table, i), <#= refSpanArgs #>);
            }
        }

        private void LoopUniform<U>(<#= spanParams #>, UniformComponentAction<U, <#= types #>> action, U uniform)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (!Pass(<#= inSpanArgs #>)) continue;
                action(uniform, <#= refSpanArgs #>);
            }
        }

        private void LoopUniformEntity<U>(Archetype table, <#= spanParams #>, UniformEntityComponentAction<U, <#= types #>> action, U uniform)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (!Pass(<#= inSpanArgs #>)) continue;
                action(uniform, new EntityRef(table, i), <#= refSpanArgs #>);
            }
        }

        private void LoopDual(<#= spanParams #>, ComponentAction<<#= types #>> included, ComponentAction<<#= types #>> excluded)
        {
            var length = span0.Length;
            for (var i = 0; i < length; i++)
            {
                if (Pass(<#= inSpanArgs #>)) included(<#= refSpanArgs #>);
                else excluded(<#= refSpanArgs #>);
            }
        }

        private void LoopDualEntity(Archetype table, <#= spanParams #>, EntityComponentAction<<#= types #>> included, EntityComponentAction<<#= types #>> excluded)
        {
            var length = span0.Length;
